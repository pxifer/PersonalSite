---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ContactSection from '@/components/common/ContactSection.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { profile, skills, experience } from '@/data/profile';
import { getPublishedPosts } from '@/lib/content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = getPublishedPosts(await getCollection('blog')).slice(0, 3);
const pageTitle = `${profile.name} · ${profile.role}`;
---

<BaseLayout title={pageTitle} description={profile.intro}>
  <div class="example-ribbon" role="note">
    {
      profile.isExample
        ? '演示站点 · 资料与文章均为示例，请替换后再正式发布'
        : '演示站点 · 项目与文章仍含示例内容'
    }
  </div>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="availability">
        <span class="availability-dot"></span>{profile.availability}
      </p>
      <p class="eyebrow hero-eyebrow">{profile.role}</p>
      <h1 id="hero-title">{profile.headline}</h1>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#featured-projects"
          >查看代表项目 <span aria-hidden="true">↓</span></a
        >
        <a class="button button-quiet" href={withBase('/about')}
          >关于我 <span aria-hidden="true">↗</span></a
        >
      </div>
      {
        profile.isExample && (
          <p class="example-note">以上为示例表达，发布前请替换为真实个人资料。</p>
        )
      }
    </div>
    <div class="hero-aside" aria-hidden="true">
      <div class="hero-monogram">{profile.wordmark}</div>
      <div class="hero-aside-label"><span>BUILD</span><span>WITH INTENT</span></div>
      <span class="hero-coordinate">PERSONAL SITE / 001</span>
    </div>
    <a class="hero-scroll" href="#featured-projects"><span></span> 向下探索</a>
  </section>

  <section class="section-space container" id="featured-projects">
    <div class="section-topline">
      <SectionHeading
        eyebrow="SELECTED WORK"
        title="用项目说明我如何工作。"
        description="从真实问题出发，梳理职责、关键决策与交付结果。"
      />
      <a class="text-link section-more" href={withBase('/projects')}
        >全部项目 <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="project-grid">
      {
        projects
          .slice(0, 2)
          .map((project, index) => (
            <ProjectCard project={project} featured={index === 0} />
          ))
      }
    </div>
    <p class="section-disclaimer">项目卡片为结构示例，不代表真实项目或成果。</p>
  </section>

  <section class="section-space section-soft">
    <div class="container">
      <SectionHeading
        eyebrow="CAPABILITIES"
        title="按解决的问题组织能力。"
        description="技术是工具，重要的是它如何服务于体验、数据和交付。"
      />
      <div class="skills-grid">
        {
          skills.map((group, index) => (
            <article class="skill-card">
              <span class="skill-index">0{index + 1}</span>
              <h3>{group.title}</h3>
              <p class="muted-copy">{group.description}</p>
              <ul class="tag-list">
                {group.tools.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      {
        profile.isExample && (
          <p class="section-disclaimer">
            技能分组为示例，请仅保留实际使用过的技术和工具。
          </p>
        )
      }
    </div>
  </section>

  <section class="section-space container">
    <div class="section-topline">
      <SectionHeading
        eyebrow="EXPERIENCE"
        title="重要的阶段与积累。"
        description="精选与专业方向相关的经历和贡献。"
      />
      <a class="text-link section-more" href={withBase('/about')}
        >更多关于我 <span aria-hidden="true">↗</span></a
      >
    </div>
    <ol class="experience-list">
      {
        experience.map((item, index) => (
          <li class="experience-item">
            <span class="experience-index">0{index + 1}</span>
            <p class="experience-period">{item.period}</p>
            <div>
              <>
                <h3>
                  {item.role} <span>· {item.organization}</span>
                </h3>
                <p class="muted-copy">{item.contribution}</p>
              </>
            </div>
          </li>
        ))
      }
    </ol>
    {
      profile.isExample && (
        <p class="section-disclaimer">经历为内容结构示例，公开前请核实并替换。</p>
      )
    }
  </section>

  <section class="section-space section-soft">
    <div class="container">
      <div class="section-topline">
        <SectionHeading
          eyebrow="NOTES"
          title="最近写下的思考。"
          description="记录项目实践、工程方法与持续学习。"
        />
        <a class="text-link section-more" href={withBase('/blog')}
          >全部文章 <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="posts-grid">{posts.map((post) => <PostCard post={post} />)}</div>
      <p class="section-disclaimer">当前文章用于预览页面结构，不是已完成的真实文章。</p>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
