---
import { profile } from '@/data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section class="contact-section section-space" id="contact">
  <div class="container contact-panel">
    <SectionHeading
      eyebrow="CONTACT"
      title="一起聊聊下一件事。"
      description="如果你正在寻找工程伙伴，或想交流项目中的具体问题，欢迎联系。"
    />
    <div class="contact-actions">
      {
        profile.email ? (
          <>
            <a class="button button-primary" href={`mailto:${profile.email}`}>
              发送邮件 <span aria-hidden="true">↗</span>
            </a>
            <button
              class="button button-quiet"
              type="button"
              data-copy-email={profile.email}
            >
              复制邮箱
            </button>
            <span class="sr-only" aria-live="polite" data-copy-status />
          </>
        ) : (
          <span class="contact-missing">邮箱待补充</span>
        )
      }
      {
        profile.github && (
          <a
            class="button button-quiet"
            href={profile.github}
            target="_blank"
            rel="noreferrer"
          >
            GitHub ↗
          </a>
        )
      }
      {
        profile.socialLinks.map((link) => (
          <a
            class="button button-quiet"
            href={link.href}
            target="_blank"
            rel="noreferrer"
          >
            {link.label} ↗
          </a>
        ))
      }
    </div>
    {profile.email && <p class="contact-email">{profile.email}</p>}
  </div>
</section>
