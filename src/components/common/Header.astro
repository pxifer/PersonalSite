---
import { profile } from '@/data/profile';
import { withBase } from '@/lib/paths';

const { currentPath = '/' } = Astro.props;
const navigation = [
  { href: '/', label: '首页' },
  { href: '/projects', label: '项目' },
  { href: '/blog', label: '博客' },
  { href: '/about', label: '关于' },
];
const contactHref = withBase(currentPath === '/' ? '/#contact' : '/about#contact');
---

<a class="skip-link" href="#main-content">跳到正文</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={withBase('/')} aria-label={`${profile.name}，返回首页`}>
      <span class="wordmark-mark">{profile.wordmark}</span>
      <span class="wordmark-name">{profile.name}</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="打开导航菜单"
      data-menu-toggle
    >
      <span></span><span></span>
    </button>
    <nav
      class="primary-navigation"
      id="primary-navigation"
      aria-label="主导航"
      data-navigation
    >
      {
        navigation.map(({ href, label }) => (
          <a
            href={withBase(href)}
            aria-current={
              currentPath === href || (href !== '/' && currentPath.startsWith(href))
                ? 'page'
                : undefined
            }
          >
            {label}
          </a>
        ))
      }
      <a class="button button-small nav-contact" href={contactHref}>联系我</a>
    </nav>
  </div>
</header>
