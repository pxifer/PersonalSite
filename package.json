{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/generate-social-card.mjs",
    "dev": "astro dev",
    "dev:host": "astro dev --host 0.0.0.0",
    "check": "astro check && node scripts/check-content.mjs",
    "check:release": "node scripts/check-content.mjs --release",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prebuild": "node scripts/generate-social-card.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/sitemap": "^3.6.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
